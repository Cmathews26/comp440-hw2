{
  "mcpServers": {
    "cool-colab-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "tools/cool-colab-mcp",
        "cool-colab-mcp"
      ],
      "env": {
        "COOL_COLAB_MCP_NOTEBOOK_DIRS": "../../colab"
      }
    }
  }
}
